<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="paperformat_doctor_a4" model="report.paperformat">
        <field name="name">Doctor report A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_doctor" model="ir.actions.report">
        <field name="name">Doctor Report</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_hospital.report_doctor_template</field>
        <field name="report_file">hr_hospital.report_doctor_template</field>
        <field name="paperformat_id" ref="paperformat_doctor_a4"/>
        <field name="binding_model_id" ref="model_hr_hospital_doctor"/>
        <field name="binding_view_types">list,form</field>
        <field name="print_report_name">'Doctor report - %s' % object.name</field>
    </record>

</odoo>
