<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_visit_tree" model="ir.ui.view">
        <field name="name">hr.hospital.visit.tree</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'">
                <field name="scheduled_date"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_visit_form" model="ir.ui.view">
        <field name="name">hr.hospital.visit.form</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_done" type="object"
                            string="Mark as completed"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel visit"
                            invisible="state in ('cancelled', 'done')"/>
                    <button name="action_reset_to_planned" type="object"
                            string="Reset to planned"
                            invisible="state == 'planned'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="planned,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_same_disease_visits"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-stethoscope"
                                invisible="not disease_id">
                            <field name="same_disease_visit_count"
                                   widget="statinfo"
                                   string="Same disease"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="disease_id"/>
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="visit_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary / Epicrisis">
                            <field name="summary"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_visit_search" model="ir.ui.view">
        <field name="name">hr.hospital.visit.search</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>
                <filter name="planned" string="Planned"
                        domain="[('state', '=', 'planned')]"/>
                <filter name="done" string="Completed"
                        domain="[('state', '=', 'done')]"/>
                <filter name="cancelled" string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="this_year" string="This year"
                        domain="[('scheduled_date', '>=', time.strftime('%Y-01-01')),
                                 ('scheduled_date', '&lt;=', time.strftime('%Y-12-31 23:59:59'))]"/>
                <separator/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
                <filter name="group_doctor" string="Doctor"
                        context="{'group_by': 'doctor_id'}"/>
                <filter name="group_disease" string="Disease"
                        context="{'group_by': 'disease_id'}"/>
                <searchpanel>
                    <field name="doctor_id" string="Doctor"
                           icon="fa-user-md" enable_counters="1"
                           select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_visit_calendar" model="ir.ui.view">
        <field name="name">hr.hospital.visit.calendar</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <calendar date_start="scheduled_date" color="doctor_id"
                      mode="month" string="Visits">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_visit_pivot" model="ir.ui.view">
        <field name="name">hr.hospital.visit.pivot</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visits pivot" sample="1">
                <field name="doctor_id" type="row"/>
                <field name="state" type="col"/>
                <field name="scheduled_date" interval="month" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_visit_graph" model="ir.ui.view">
        <field name="name">hr.hospital.visit.graph</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <graph string="Visits chart" type="bar" stacked="1" sample="1">
                <field name="scheduled_date" interval="month"/>
                <field name="disease_id"/>
            </graph>
        </field>
    </record>

    <record id="action_hospital_visit" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">hr.hospital.visit</field>
        <field name="view_mode">list,form,calendar,pivot,graph</field>
        <field name="context">{'search_default_this_year': 1}</field>
    </record>

</odoo>
