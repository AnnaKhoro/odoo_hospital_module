<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hospital_doctor_tree" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.tree</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialization"/>
                <field name="category_id"/>
                <field name="is_intern"/>
                <field name="mentor_id"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.form</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_visits"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-stethoscope">
                            <field name="visit_count"
                                   widget="statinfo"
                                   string="Visits"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="specialization"/>
                            <field name="category_id"/>
                            <field name="user_id"/>
                            <field name="is_intern"/>
                        </group>
                        <group>
                            <field name="gender"/>
                            <field name="birthday"/>
                            <field name="age"/>
                            <field name="blood_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mentor" invisible="not is_intern">
                            <group>
                                <field name="mentor_id"
                                       domain="[('is_intern', '=', False)]"/>
                            </group>
                        </page>
                        <page string="Interns"
                              invisible="is_intern or not mentee_ids">
                            <field name="mentee_ids" mode="kanban"
                                   readonly="1">
                                <kanban>
                                    <field name="name"/>
                                    <field name="specialization"/>
                                    <field name="category_id"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="o_kanban_record_top">
                                                <strong>
                                                    <field name="name"/>
                                                </strong>
                                            </div>
                                            <div>
                                                <field name="specialization"/>
                                            </div>
                                            <div>
                                                <field name="category_id"/>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_doctor_kanban" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.kanban</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id"
                    quick_create="1"
                    on_create="quick_create"
                    sample="1">
                <field name="color"/>
                <field name="is_intern"/>
                <field name="mentor_id"/>
                <field name="specialization"/>
                <field name="category_id"/>
                <field name="mentee_ids"/>
                <field name="mentee_names"/>
                <field name="mentor_label"/>
                <field name="mentees_label"/>
                <templates>
                    <t t-name="menu">
                        <a class="dropdown-item" role="menuitem"
                           type="delete">Delete</a>
                        <div role="separator" class="dropdown-divider"/>
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card">
                        <t t-set="kanban_colors"
                           t-value="{
                               0: 'transparent',
                               1: '#F06050',
                               2: '#F4A460',
                               3: '#F7CD1F',
                               4: '#6CC1ED',
                               5: '#814968',
                               6: '#EB7E7F',
                               7: '#2C8397',
                               8: '#475577',
                               9: '#D6145F',
                               10: '#30C381',
                               11: '#9365B8',
                           }"/>
                        <div t-attf-style="padding: 4px; border-left: 6px solid #{kanban_colors[record.color.raw_value or 0] or 'transparent'};">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong>
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div>
                                <field name="specialization"/>
                            </div>
                            <div t-if="record.category_id.raw_value">
                                <i class="fa fa-graduation-cap me-1"
                                   title="Qualification" role="img"
                                   aria-label="Qualification"/>
                                <field name="category_id"/>
                            </div>
                            <div t-if="record.mentor_label.raw_value">
                                <b><field name="mentor_label"/></b>
                            </div>
                            <div t-if="record.mentees_label.raw_value"
                                 class="mt-2">
                                <b><field name="mentees_label"/></b>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hospital_doctor_search" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.search</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="specialization"/>
                <field name="category_id"/>
                <filter name="interns" string="Interns"
                        domain="[('is_intern', '=', True)]"/>
                <filter name="mentors" string="Mentors"
                        domain="[('mentee_ids', '!=', False)]"/>
                <separator/>
                <filter name="group_category" string="Category"
                        context="{'group_by': 'category_id'}"/>
                <filter name="group_specialization" string="Specialization"
                        context="{'group_by': 'specialization'}"/>
            </search>
        </field>
    </record>

    <record id="action_hospital_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hr.hospital.doctor</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
