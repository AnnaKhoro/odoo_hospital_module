<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hospital_patient_tree" model="ir.ui.view">
        <field name="name">hr.hospital.patient.tree</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="doctor_id"/>
                <field name="insurance_policy_number"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_patient_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.form</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_new_visit"
                            type="object"
                            string="New visit"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_visits"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-stethoscope">
                            <field name="visit_count"
                                   widget="statinfo"
                                   string="Visits"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="doctor_id"/>
                            <field name="insurance_policy_number"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="gender"/>
                            <field name="birthday"/>
                            <field name="age"/>
                            <field name="blood_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Doctor history">
                            <field name="doctor_history_ids">
                                <list>
                                    <field name="doctor_id"/>
                                    <field name="assignment_date"/>
                                    <field name="change_date"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_patient_search" model="ir.ui.view">
        <field name="name">hr.hospital.patient.search</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Patient"
                       filter_domain="['|', ('name', 'ilike', self),
                                            ('phone', 'ilike', self)]"/>
                <field name="phone"/>
                <field name="doctor_id"/>
                <filter name="group_doctor" string="Personal doctor"
                        context="{'group_by': 'doctor_id'}"/>
                <filter name="group_gender" string="Gender"
                        context="{'group_by': 'gender'}"/>
            </search>
        </field>
    </record>

    <record id="action_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
