<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_doctor_category_tree" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.category.tree</field>
        <field name="model">hr.hospital.doctor.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_doctor_category_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.category.form</field>
        <field name="model">hr.hospital.doctor.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                    <notebook>
                        <page string="Doctors">
                            <field name="doctor_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="specialization"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_doctor_category" model="ir.actions.act_window">
        <field name="name">Doctor Categories</field>
        <field name="res_model">hr.hospital.doctor.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
