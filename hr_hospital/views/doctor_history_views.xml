<odoo>

    <record id="view_doctor_history_tree" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.history.tree</field>
        <field name="model">hr.hospital.doctor.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="assignment_date"/>
                <field name="change_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_doctor_history_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.history.form</field>
        <field name="model">hr.hospital.doctor.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="patient_id"/>
                        <field name="doctor_id"/>
                        <field name="assignment_date"/>
                        <field name="change_date"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_doctor_history" model="ir.actions.act_window">
        <field name="name">Doctor history</field>
        <field name="res_model">hr.hospital.doctor.history</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
