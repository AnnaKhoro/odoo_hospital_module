<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_disease_tree" model="ir.ui.view">
        <field name="name">hr.hospital.disease.tree</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="view_disease_search" model="ir.ui.view">
        <field name="name">hr.hospital.disease.search</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="parent_id"/>
                <searchpanel>
                    <field name="parent_id" string="Parent disease"
                           icon="fa-folder" enable_counters="1"
                           hierarchize="1" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_disease_form" model="ir.ui.view">
        <field name="name">hr.hospital.disease.form</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="complete_name"/>
                    </group>
                    <notebook>
                        <page string="Sub-diseases">
                            <field name="child_ids">
                                <list>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hospital_disease" model="ir.actions.act_window">
        <field name="name">Diseases</field>
        <field name="res_model">hr.hospital.disease</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
